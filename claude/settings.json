{
  "permissions": {
    "deny": [
      "Bash(op read *)",
      "Bash(op item get *)",
      "Bash(op item list *)",
      "Bash(op inject *)",
      "Read(~/.ssh/**)",
      "Read(~/.config/mac-setup/**)",
      "Read(/etc/wireguard/**)",
      "Read(/opt/homebrew/etc/wireguard/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(git reset --hard *)",
      "Bash(git filter-repo *)"
    ]
  },
  "theme": "auto"
}
